server {
    listen 80;
    listen [::]:80;
    server_name gtfs.osmz.ee gtb.osmz.ee;

    # For certbot
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/html/;
    }

    return 301 https://gtb.osmz.ee$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name gtfs.osmz.ee;
    return 301 https://gtb.osmz.ee$request_uri;

    ssl_certificate {{ cert_path.gtfs }}/fullchain.pem;
    ssl_certificate_key {{ cert_path.gtfs }}/privkey.pem;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name gtb.osmz.ee;

    http2 on;

    ssl_certificate {{ cert_path.gtb }}/fullchain.pem;
    ssl_certificate_key {{ cert_path.gtb }}/privkey.pem;

    charset UTF-8;

    location / {
      root /var/www/html;
    }

    location /gtb/ {
      alias {{ gtb_path }}/;
      autoindex on;
    }
}
